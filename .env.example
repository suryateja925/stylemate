APP_ENV=development
DATABASE_URL=sqlite:///./stylemate.db
FRONTEND_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=
MAX_UPLOAD_MB=10
AI_REQUEST_TIMEOUT_SECONDS=45
MEDIA_ROOT=./media
MEDIA_STORAGE_PROVIDER=local

# Production Supabase project. Use a PostgreSQL session-pooler URL for DATABASE_URL.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=wardrobe-private
# Optional only for projects still using legacy HS256 JWT signing keys.
SUPABASE_JWT_SECRET=

# Configure exactly one provider with a model ID verified for your account.
# The same text-capable model powers chat and voice command/tool selection.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional real weather provider. Leave blank to make recommendations weather-neutral.
WEATHER_PROVIDER=
WEATHER_API_KEY=
